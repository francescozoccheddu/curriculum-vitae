                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "readOnly": true,
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "pattern": "^(?! )(?!.* $)(?!.* {2})[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}\\p{Cn}\\p{Extended_Pictographic}\\r\\n\\t]+$"
                        },
                        "at": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^(?! )(?!.* $)(?!.* {2})[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}\\p{Cn}\\p{Extended_Pictographic}\\r\\n\\t]+$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "year": {
                          "anyOf": [
                            {
                              "type": "number",
