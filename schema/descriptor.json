{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "profile": {
      "anyOf": [
        {
          "readOnly": true,
          "type": "object",
          "properties": {
            "firstName": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?! )(?!.* $)(?!.* {2})[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}\\p{Cn}\\p{Extended_Pictographic}\\r\\n\\t]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastName": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?! )(?!.* $)(?!.* {2})[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}\\p{Cn}\\p{Extended_Pictographic}\\r\\n\\t]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "birthDate": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contacts": {
              "anyOf": [
                {
                  "readOnly": true,
                  "type": "object",
                  "properties": {
                    "phone": {
                      "anyOf": [
                        {
                          "readOnly": true,
                          "type": "object",
                          "properties": {
                            "prefix": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^\\+\\d{1,3}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "number": {
                              "type": "string",
                              "pattern": "^\\d+(?: \\d+)*$"
                            }
                          },
                          "required": ["number"],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "location": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?! )(?!.* $)(?!.* {2})[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}\\p{Cn}\\p{Extended_Pictographic}\\r\\n\\t]+$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "email": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "github": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "linkedin": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "drivingLicense": {
              "type": ["boolean", "null"]
            },
            "languages": {
              "readOnly": true,
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "readOnly": true,
                    "type": "object",
                    "properties": {
                      "language": {
                        "type": "string",
                        "pattern": "^[a-z]{2}$"
                      },
                      "level": {
                        "anyOf": [
                          {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[ABC][12]$"
                              },
                              {
                                "type": "string",
                                "const": "native"
                              }
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": ["language"],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "bio": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?! )(?!.* $)(?!.* {2})[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}\\p{Cn}\\p{Extended_Pictographic}\\r\\n\\t]+$"
