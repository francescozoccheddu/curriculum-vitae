                      "value": {
                        "type": "string",
                        "pattern": "^(?! )(?!.* $)(?!.* {2})[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}\\p{Cn}\\p{Extended_Pictographic}\\r\\n\\t]+$"
